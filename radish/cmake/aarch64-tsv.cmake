# Cross toolchain for the ThinkSmart View (Cortex-A53, Arch Linux ARM sysroot).
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(TSV_SYSROOT /home/jethac/Projects/lenovo-8/streams/gpu-mesa16/work/sysroot CACHE PATH "target sysroot")
set(CMAKE_SYSROOT ${TSV_SYSROOT})
set(CMAKE_C_COMPILER clang)
set(CMAKE_C_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-gnu)
file(REAL_PATH ${TSV_SYSROOT}/usr/lib/gcc/aarch64-linux-gnu/16 TSV_GCC_INSTALL)
set(CMAKE_C_FLAGS_INIT "-mcpu=cortex-a53 --gcc-install-dir=${TSV_GCC_INSTALL}")
set(CMAKE_CXX_FLAGS_INIT "-mcpu=cortex-a53 --gcc-install-dir=${TSV_GCC_INSTALL}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld --rtlib=libgcc -L${CMAKE_SYSROOT}/usr/lib -Wl,-rpath-link,${CMAKE_SYSROOT}/usr/lib")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld --rtlib=libgcc -L${CMAKE_SYSROOT}/usr/lib -Wl,-rpath-link,${CMAKE_SYSROOT}/usr/lib")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
