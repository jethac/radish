+        }
+        barrier();
+    }
+    if (col0 + col < p.N) {
+        if (row0 + row < p.M) data_d[d + (col0 + col) * p.stride_d + row0 + row] = sum.x;
+        if (row0 + row + 1 < p.M) data_d[d + (col0 + col) * p.stride_d + row0 + row + 1] = sum.y;
+    }
+    if (col0 + col + 1 < p.N) {
+        if (row0 + row < p.M) data_d[d + (col0 + col + 1) * p.stride_d + row0 + row] = sum.z;
+        if (row0 + row + 1 < p.M) data_d[d + (col0 + col + 1) * p.stride_d + row0 + row + 1] = sum.w;
+    }
+}
