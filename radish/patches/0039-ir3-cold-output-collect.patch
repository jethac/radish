+static bool
+radish_cold_output_collect(struct ir3_instruction *instr)
+{
+   if (instr->opc != OPC_META_COLLECT || instr->block->loop_depth != 0 ||
+       instr->dsts_count != 1 || instr->srcs_count != 4 ||
+       instr->dsts[0]->wrmask != 0xf ||
+       (instr->dsts[0]->flags & (IR3_REG_HALF | IR3_REG_SHARED)))
+      return false;
+
+   struct ir3_block *hot = NULL;
+   struct ir3_instruction *groups[4];
+   for (unsigned i = 0; i < 4; i++) {
+      struct ir3_register *src = instr->srcs[i];
+      if (!(src->flags & IR3_REG_SSA) || !src->def ||
+          (src->flags & (IR3_REG_HALF | IR3_REG_SHARED | IR3_REG_RELATIV | IR3_REG_ARRAY)))
+         return false;
+      struct ir3_instruction *mad = src->def->instr;
+      if (mad->opc != OPC_MAD_F32 || mad->dsts_count != 1 ||
+          mad->srcs_count != 3 || mad->dsts[0] != src->def ||
+          mad->block->loop_depth != 2 || !ir3_instr_is_rpt(mad) ||
+          (hot && hot != mad->block))
+         return false;
+      hot = mad->block;
+      groups[i] = ir3_instr_first_rpt(mad);
+      if (ir3_instr_rpt_length(groups[i]) != 2 ||
+          groups[i]->opc != OPC_MAD_F32 ||
+          groups[i]->rpt_next->opc != OPC_MAD_F32)
+         return false;
+      for (unsigned j = 0; j < i; j++) {
+         if (groups[j] == groups[i])
+            return false;
+      }
+   }
+
+   foreach_instr (store, &instr->block->instr_list) {
+      if (store->opc == OPC_STGB && store->srcs_count == 4 &&
+          (store->srcs[0]->flags & IR3_REG_IMMED) &&
+          store->srcs[0]->uim_val == 2 &&
+          (store->srcs[1]->flags & IR3_REG_SSA) &&
+          store->srcs[1]->def == instr->dsts[0] &&
+          store->srcs[1]->wrmask == 0xf)
+         return true;
+   }
+   return false;
+}
