+static unsigned
+radish_deferred_collects(struct ir3 *ir, struct ir3_instruction *deferred[8])
+{
+   const char *requested = getenv("RADISH_IR3_DEFER_COLD_COLLECT");
+   if (!requested || strcmp(requested, "1") ||
+       ir->type != MESA_SHADER_COMPUTE ||
+       fd_dev_gpu_id(ir->compiler->dev_id) != 506)
+      return 0;
+
+   const nir_shader *nir = NULL;
+   foreach_block (block, &ir->block_list) {
+      if (block->nblock && block->nblock->impl && block->nblock->impl->function) {
+         nir = block->nblock->impl->function->shader;
+         break;
+      }
+   }
+   if (!nir || nir->info.stage != MESA_SHADER_COMPUTE ||
+       nir->info.workgroup_size[0] != 16 ||
+       nir->info.workgroup_size[1] != 8 ||
+       nir->info.workgroup_size[2] != 1 ||
+       nir->info.shared_size != 16384 || nir->info.num_ssbos != 4)
+      return 0;
+
+   unsigned count = 0;
+   foreach_block (block, &ir->block_list) {
+      foreach_instr (instr, &block->instr_list) {
+         if (!radish_cold_output_collect(instr))
+            continue;
+         if (count == 8)
+            return 0;
+         deferred[count++] = instr;
+      }
+   }
+   return count == 8 ? count : 0;
+}
