+struct rd_border_color {
+   uint32_t fp32[4];
+   uint16_t ui16[4];
+   int16_t si16[4];
+   uint16_t fp16[4];
+   uint16_t rgb565, rgb5a1, rgba4;
+   uint8_t pad0[2], ui8[4];
+   int8_t si8[4];
+   uint32_t rgb10a2, z24;
+   uint16_t srgb[4];
