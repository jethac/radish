+static nir_mem_access_size_align
+rd_storage16_access(nir_intrinsic_op intrin, uint8_t bytes, uint8_t bit_size,
+                    uint32_t align_mul, uint32_t align_offset,
+                    bool offset_is_const, enum gl_access_qualifier access,
+                    const void *data)
+{
+   (void)intrin;
+   (void)align_mul;
+   (void)align_offset;
+   (void)offset_is_const;
+   (void)access;
+   (void)data;
+   return (nir_mem_access_size_align) {
+      .num_components = bit_size == 16 ? 1 : bytes / (bit_size / 8),
+      .bit_size = bit_size == 16 ? 32 : bit_size,
+      .align = bit_size == 16 ? 4 : 1,
+      .shift = nir_mem_access_shift_method_scalar,
+   };
+}
+
+bool
+rd_nir_lower_storage16(nir_shader *shader)
+{
+   bool found = false;
+   nir_foreach_function_impl(impl, shader) {
+      nir_foreach_block(block, impl) {
+         nir_foreach_instr(instr, block) {
+            if (instr->type != nir_instr_type_intrinsic)
+               continue;
+            nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+            unsigned bits, offset;
+            if (intr->intrinsic == nir_intrinsic_load_ssbo) {
+               bits = intr->def.bit_size;
+               offset = 1;
+            } else if (intr->intrinsic == nir_intrinsic_store_ssbo) {
+               bits = nir_src_bit_size(intr->src[0]);
+               offset = 2;
+            } else {
+               continue;
+            }
+            if (bits != 16)
+               continue;
+            if (intr->src[offset].ssa->bit_size != 32 ||
+                nir_intrinsic_align(intr) < 2 ||
+                (nir_intrinsic_has_offset_shift(intr) &&
+                 nir_intrinsic_offset_shift(intr)))
+               return false;
+            found = true;
+         }
+      }
+   }
+   if (found) {
+      const nir_lower_mem_access_bit_sizes_options options = {
+         .modes = nir_var_mem_ssbo,
+         .callback = rd_storage16_access,
+         .may_lower_unaligned_stores_to_atomics = true,
+      };
+      NIR_PASS(_, shader, nir_lower_mem_access_bit_sizes, &options);
+   }
+   return true;
+}
