 static bool
+rd_paired_shared_batch_resources(struct rd_device *device,
+                                  const struct rd_pipeline *pipeline)
+{
+   const struct ir3_shader_variant *v = pipeline->variant;
+   if (fd_dev_gpu_id(fd_pipe_dev_id(device->pipe)) != 506 ||
+       device->info.num_sp_cores != 1 || device->info.threadsize_base != 32 ||
+       v->local_size[0] != 8 || v->local_size[1] != 8 || v->local_size[2] != 1 ||
+       !v->has_barrier || v->loops != 4 || v->shared_size != 6144 || v->pvtmem_size ||
+       v->info.double_threadsize || v->info.preamble_instrs_count ||
+       v->info.max_reg + 1 > 16 || !v->instrlen || v->instrlen > 32 ||
+       !rd_shared_batch_resources(pipeline))
+      return false;
+   const uint64_t pair_threads = 2ull * 64;
+   const uint64_t pair_shared = 2ull * v->shared_size;
+   return pair_threads * ir3_shader_halfregs(v) <= 4096 &&
+          pair_shared <= 16384 && pair_shared <= device->info.cs_shared_mem_size;
+}
