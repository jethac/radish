+bool
+rd_nir_lower_compute_resources(nir_shader *shader,
+   const struct rd_nir_resource_binding *bindings, uint32_t binding_count,
+   struct rd_nir_resource_usage *usage)
+{
+   if (!shader || shader->info.stage != MESA_SHADER_COMPUTE || !usage ||
+       (binding_count && !bindings))
+      return false;
+   memset(usage, 0, sizeof(*usage));
+   for (uint32_t i = 0; i < binding_count; i++) {
+      const struct rd_nir_resource_binding *entry = &bindings[i];
+      if (!entry->count || entry->descriptor_slot >= 32 ||
+          entry->count > 32 - entry->descriptor_slot)
+         return false;
+   }
