#version 450
layout(local_size_x=1) in;
layout(set=0,binding=0) uniform sampler2DArray nearest_image;
layout(set=0,binding=1) uniform sampler2DArray linear_image;
layout(set=0,binding=2) uniform usampler2D block_image;
layout(set=0,binding=3) uniform usampler2D copy_image;
layout(set=0,binding=5) uniform sampler2DArray unorm_image;
layout(set=0,binding=6) uniform sampler2D rgba8_srgb_image;
layout(set=0,binding=4,std430) writeonly buffer Results { uint words[]; };
void main() {
 uint lane=gl_GlobalInvocationID.x,base=lane*35u;
 ivec2 xy=ivec2(int(lane&7u),int(lane>>3u));int layer=int(lane&1u);
 vec4 a=texelFetch(nearest_image,ivec3(xy,layer),0);
 vec4 b=textureLod(linear_image,vec3((vec2(xy)+vec2(1.0))/8.0,float(layer)),0.0);
 vec4 c=texelFetch(nearest_image,ivec3(xy/2,layer),1);
 vec4 d=texelFetch(nearest_image,ivec3(xy/4,layer),2);
 for(uint k=0;k<4;k++){words[base+k]=floatBitsToUint(a[k]);words[base+4u+k]=floatBitsToUint(b[k]);words[base+8u+k]=floatBitsToUint(c[k]);words[base+12u+k]=floatBitsToUint(d[k]);}
 if(lane==35u) {
  ivec2 taps[4]=ivec2[4](xy,xy+ivec2(1,0),xy+ivec2(0,1),xy+ivec2(1,1));
  for(uint tap=0;tap<4;tap++) {
   vec4 v=texelFetch(nearest_image,ivec3(taps[tap],layer),0);
   vec4 encoded=texelFetch(unorm_image,ivec3(taps[tap],layer),0);
   vec4 rgba8=texelFetch(rgba8_srgb_image,ivec2(int(tap&1u),int(tap>>1u)),0);
   for(uint component=0;component<4;component++){words[2240u+tap*4u+component]=floatBitsToUint(v[component]);words[2256u+tap*4u+component]=floatBitsToUint(encoded[component]);words[2272u+tap*4u+component]=floatBitsToUint(rgba8[component]);}
  }
 }
 ivec3 s0=textureSize(nearest_image,0),s1=textureSize(nearest_image,1),s2=textureSize(nearest_image,2);
 for(uint k=0;k<3;k++){words[base+16u+k]=uint(s0[k]);words[base+19u+k]=uint(s1[k]);words[base+22u+k]=uint(s2[k]);}
 uvec4 raw=texelFetch(block_image,ivec2(0),0);for(uint k=0;k<4;k++)words[base+25u+k]=raw[k];
 uvec4 copied=texelFetch(copy_image,ivec2(0),0);for(uint k=0;k<4;k++)words[base+29u+k]=copied[k];
 ivec2 bs=textureSize(block_image,0);words[base+33u]=uint(bs.x);words[base+34u]=uint(bs.y);
}
