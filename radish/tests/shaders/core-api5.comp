#version 450
layout(local_size_x=4, local_size_y=2, local_size_z=2) in;
layout(set=0,binding=0,std430) buffer Output { uint values[]; } output_data;
layout(set=0,binding=1,std430) readonly buffer A { uint values[]; } a;
layout(set=0,binding=2,std430) readonly buffer B { uint values[]; } b;
layout(set=0,binding=3,std430) readonly buffer C { uint values[]; } c;
layout(push_constant) uniform Params { uvec4 base; uvec4 grid; } p;
void main()
{
    uvec3 relative = gl_GlobalInvocationID - p.base.xyz * gl_WorkGroupSize;
    uvec3 extent = p.grid.xyz * gl_WorkGroupSize;
    if (any(greaterThanEqual(relative, extent))) return;
    uint index = p.base.w + 16u * ((relative.z * extent.y + relative.y) * extent.x + relative.x);
    output_data.values[index + 0u] = gl_NumWorkGroups.x;
    output_data.values[index + 1u] = gl_NumWorkGroups.y;
    output_data.values[index + 2u] = gl_NumWorkGroups.z;
    output_data.values[index + 3u] = gl_WorkGroupID.x;
    output_data.values[index + 4u] = gl_WorkGroupID.y;
    output_data.values[index + 5u] = gl_WorkGroupID.z;
    output_data.values[index + 6u] = gl_GlobalInvocationID.x;
    output_data.values[index + 7u] = gl_GlobalInvocationID.y;
    output_data.values[index + 8u] = gl_GlobalInvocationID.z;
    output_data.values[index + 9u] = gl_LocalInvocationID.x;
    output_data.values[index + 10u] = gl_LocalInvocationID.y;
    output_data.values[index + 11u] = gl_LocalInvocationID.z;
    output_data.values[index + 12u] = gl_LocalInvocationIndex;
    output_data.values[index + 13u] = a.values[0];
    output_data.values[index + 14u] = b.values[0];
    output_data.values[index + 15u] = c.values[0];
}
