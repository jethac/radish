#version 450
#pragma use_storage_buffer
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
layout(local_size_x=32,local_size_y=1,local_size_z=1) in;
struct Item { uint8_t u; int8_t s; };
layout(set=0,binding=0,std430) writeonly buffer Results { uint words[]; } result;
layout(set=0,binding=1,std430) readonly buffer Source { Item values[]; } source_data;
layout(set=0,binding=2,std430) writeonly buffer Target { Item values[]; } target_data;
layout(set=0,binding=3,std430) coherent buffer Adjacent { uint8_t values[]; } adjacent;
void main()
{
    uint i=gl_LocalInvocationID.x;
    target_data.values[i].u=source_data.values[i].u;
    target_data.values[i].s=source_data.values[i].s;
    result.words[i]=uint(source_data.values[i].u);
    result.words[32u+i]=uint(int(source_data.values[i].s));
    if (i==0u) {
        result.words[64]=uint(source_data.values[0].u);
        result.words[65]=uint(source_data.values.length());
        result.words[66]=uint(target_data.values.length());
        result.words[67]=uint(adjacent.values.length());
    }
    uint slot=(i&7u)*4u+(i>>3u);
    adjacent.values[slot]=uint8_t(0xa0u+i);
    memoryBarrierBuffer();
    barrier();
    result.words[68u+i]=uint(adjacent.values[i]);
}
