#version 450
layout(local_size_x=1,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0) uniform usampler2DMS native_image;
layout(set=0,binding=1) uniform usampler2DMSArray raw_image;
layout(set=0,binding=2,std430) writeonly buffer Output { uint words[]; } output_data;
void main()
{
   uint i=gl_GlobalInvocationID.x;
   if (i>=21u) return;
   ivec2 p=ivec2(int(i%7u),int(i/7u));
   uint base=i*15u;
   for (int s=0;s<4;s++) {
      output_data.words[base+uint(s)]=texelFetch(native_image,p,s).r;
      output_data.words[base+4u+uint(s)]=texelFetch(raw_image,ivec3(p,1),s).r;
   }
   ivec2 a=textureSize(native_image);
   ivec3 b=textureSize(raw_image);
   output_data.words[base+8u]=uint(a.x);
   output_data.words[base+9u]=uint(a.y);
   output_data.words[base+10u]=uint(b.x);
   output_data.words[base+11u]=uint(b.y);
   output_data.words[base+12u]=uint(b.z);
   output_data.words[base+13u]=uint(textureSamples(native_image));
   output_data.words[base+14u]=uint(textureSamples(raw_image));
}
