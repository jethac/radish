#version 450
#ifdef RADISH_CONSECUTIVE
#define OUTPUT_BINDING 2
#else
#define OUTPUT_BINDING 11
#endif
layout(local_size_x=32) in;
layout(set=0,binding=OUTPUT_BINDING,std430) buffer Output { uint values[]; } output_data;
layout(push_constant) uniform Params { uint count; uint salt; } params;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < params.count) output_data.values[i] = i * 17u + params.salt;
}
