#version 450
layout(local_size_x=1) in;
layout(set=0,binding=0) uniform sampler2D depth_image;
layout(set=0,binding=1) uniform usampler2D stencil_image;
layout(set=0,binding=2,std430) writeonly buffer Output { uint words[]; };
void main() {
 uint i=gl_GlobalInvocationID.x;
 ivec2 p=ivec2(int(i&3u),int(i>>2u));
 vec4 d=texelFetch(depth_image,p,0);
 uvec4 s=texelFetch(stencil_image,p,0);
 for(uint c=0;c<4;c++) { words[8u*i+c]=floatBitsToUint(d[c]); words[8u*i+4u+c]=s[c]; }
}
