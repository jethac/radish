#version 450
layout(local_size_x=1,local_size_y=1,local_size_z=1) in;
layout(set=1,binding=0,std430) buffer Results { uint result[]; };
layout(set=1,binding=2,std140) uniform Static { uvec4 a; };
layout(set=1,binding=5,std140) uniform Dynamic { uvec4 b; };
layout(set=1,binding=7,std430) readonly buffer Seeds { uint seed[]; };
layout(set=1,binding=9) uniform usamplerBuffer source_texels;
layout(set=1,binding=11,r32ui) uniform uimageBuffer target_texels;
layout(set=1,binding=13,r32ui) uniform uimage2D target_image;
layout(set=1,binding=17) uniform sampler2D nearest_image;
layout(set=1,binding=19) uniform sampler2D linear_image;
layout(set=1,binding=23) uniform sampler2D depth16_image;
layout(set=1,binding=29) uniform sampler2DShadow depth16_compare;
layout(set=1,binding=31) uniform sampler2D depth32_image;
layout(set=1,binding=37) uniform sampler2DShadow depth32_compare;
void main()
{
   uint x=gl_GlobalInvocationID.x,y=gl_GlobalInvocationID.y;
   if (x>=17 || y>=5) return;
   uint i=y*17+x;
   uint tx=x%8,ty=y%4;
   float un=tx<4 ? (float(tx)+0.5)*0.25 : ((tx&1)==0 ? -0.25 : 1.25);
   float ul=tx<4 ? (float(tx)+1.0)*0.25 : ((tx&1)==0 ? -0.25 : 1.25);
   uvec4 original=imageLoad(target_image,ivec2(x,y));
   uint before=imageLoad(target_texels,int(i)).r;
   uint source=texelFetch(source_texels,int(i)).r;
   uint r=i*20;
   result[r+0]=a.x; result[r+1]=b.x; result[r+2]=seed[i];
   result[r+3]=source; result[r+4]=before; result[r+5]=original.r;
   result[r+6]=floatBitsToUint(textureLod(nearest_image,vec2(un,(float(ty)+0.5)*0.25),0.0).r);
   result[r+7]=floatBitsToUint(textureLod(linear_image,vec2(ul,(float(ty)+1.0)*0.25),0.0).r);
   result[r+8]=original.g; result[r+9]=original.b; result[r+10]=original.a;
   uint value=original.r^a.x^b.x^seed[i]^source;
   result[r+11]=value;
   result[r+12]=uint(imageSize(target_image).x); result[r+13]=uint(imageSize(target_image).y);
   result[r+14]=uint(imageSize(target_texels)); result[r+15]=uint(textureSize(source_texels));
   vec2 depth_uv=(vec2(x%4,y%4)+vec2(0.5))*0.25;
   result[r+16]=floatBitsToUint(textureLod(depth16_image,depth_uv,0.0).r);
   result[r+17]=floatBitsToUint(textureLod(depth16_compare,vec3(depth_uv,0.5),0.0));
   result[r+18]=floatBitsToUint(textureLod(depth32_image,depth_uv,0.0).r);
   result[r+19]=floatBitsToUint(textureLod(depth32_compare,vec3(depth_uv,0.5),0.0));
   imageStore(target_image,ivec2(x,y),uvec4(value,0,0,0));
   imageStore(target_texels,int(i),uvec4(before+a.x+b.x+source,0,0,0));
}
