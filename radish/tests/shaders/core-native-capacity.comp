#version 450
layout(local_size_x=1,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0) uniform usampler2D source_0;
layout(set=0,binding=1) uniform usampler2D source_1;
layout(set=0,binding=2) uniform usampler2D source_2;
layout(set=0,binding=3) uniform usampler2D source_3;
layout(set=0,binding=4) uniform usampler2D source_4;
layout(set=0,binding=5) uniform usampler2D source_5;
layout(set=0,binding=6) uniform usampler2D source_6;
layout(set=0,binding=7) uniform usampler2D source_7;
layout(set=0,binding=8) uniform usampler2D source_8;
layout(set=0,binding=9) uniform usampler2D source_9;
layout(set=0,binding=10) uniform usampler2D source_10;
layout(set=0,binding=11) uniform usampler2D source_11;
layout(set=0,binding=12) uniform usampler2D source_12;
layout(set=0,binding=13) uniform usampler2D source_13;
layout(set=0,binding=14) uniform usampler2D source_14;
layout(set=0,binding=15) uniform usampler2D source_15;
layout(set=0,binding=16,r32ui) readonly uniform uimage2D target_0;
layout(set=0,binding=17,r32ui) readonly uniform uimage2D target_1;
layout(set=0,binding=18,r32ui) readonly uniform uimageBuffer target_2;
layout(set=0,binding=19,r32ui) readonly uniform uimageBuffer target_3;
layout(set=0,binding=20,std430) writeonly buffer Results { uint words[]; };
void main() {
   uint pixel=gl_GlobalInvocationID.x;
   vec2 uv=(vec2(pixel&1u,pixel>>1u)+vec2(0.5))*0.5;
   uint base=pixel*22u;
   words[base+0u]=textureLod(source_0,uv,0.0).x;
   words[base+1u]=textureLod(source_1,uv,0.0).x;
   words[base+2u]=textureLod(source_2,uv,0.0).x;
   words[base+3u]=textureLod(source_3,uv,0.0).x;
   words[base+4u]=textureLod(source_4,uv,0.0).x;
   words[base+5u]=textureLod(source_5,uv,0.0).x;
   words[base+6u]=textureLod(source_6,uv,0.0).x;
   words[base+7u]=textureLod(source_7,uv,0.0).x;
   words[base+8u]=textureLod(source_8,uv,0.0).x;
   words[base+9u]=textureLod(source_9,uv,0.0).x;
   words[base+10u]=textureLod(source_10,uv,0.0).x;
   words[base+11u]=textureLod(source_11,uv,0.0).x;
   words[base+12u]=textureLod(source_12,uv,0.0).x;
   words[base+13u]=textureLod(source_13,uv,0.0).x;
   words[base+14u]=textureLod(source_14,uv,0.0).x;
   words[base+15u]=textureLod(source_15,uv,0.0).x;
   ivec2 size_0=imageSize(target_0);
   words[base+16u]=uint(size_0.x);
   words[base+17u]=uint(size_0.y);
   ivec2 size_1=imageSize(target_1);
   words[base+18u]=uint(size_1.x);
   words[base+19u]=uint(size_1.y);
   words[base+20u]=uint(imageSize(target_2));
   words[base+21u]=uint(imageSize(target_3));
}
