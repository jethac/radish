#version 450
layout(local_size_x=4,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) writeonly buffer Output { uint values[]; } output_data;
layout(set=0,binding=1) uniform usampler2DMSArray source_uint;
layout(set=0,binding=2) uniform usampler2DMSArray target_uint;
layout(set=0,binding=3) uniform sampler2DMSArray source_float;
layout(set=0,binding=4) uniform sampler2DMSArray target_float;
layout(set=0,binding=5) uniform sampler2DMSArray depth16;
layout(set=0,binding=6) uniform sampler2DMSArray depth32;
layout(set=0,binding=7) uniform usampler2DMSArray stencil8;
void main()
{
   uint i=gl_GlobalInvocationID.x;
   uint sample_index=i%4, pixel=i/4;
   ivec3 coordinate=ivec3(int(pixel%5),int((pixel/5)%3),int(pixel/15));
   ivec3 u_size=textureSize(source_uint), f_size=textureSize(target_float);
   uint o=i*18;
   output_data.values[o+0]=texelFetch(source_uint,coordinate,int(sample_index)).x;
   output_data.values[o+1]=texelFetch(target_uint,coordinate,int(sample_index)).x;
   output_data.values[o+2]=floatBitsToUint(texelFetch(source_float,coordinate,int(sample_index)).x);
   output_data.values[o+3]=floatBitsToUint(texelFetch(target_float,coordinate,int(sample_index)).x);
   output_data.values[o+4]=uint(textureSamples(source_uint));
   output_data.values[o+5]=uint(textureSamples(target_float));
   output_data.values[o+6]=uint(u_size.x);
   output_data.values[o+7]=uint(u_size.y);
   output_data.values[o+8]=uint(u_size.z);
   output_data.values[o+9]=uint(f_size.x);
   output_data.values[o+10]=uint(f_size.y);
   output_data.values[o+11]=uint(f_size.z);
   output_data.values[o+12]=uint(textureSamples(depth16));
   output_data.values[o+13]=uint(textureSize(depth16).z);
   output_data.values[o+14]=uint(textureSamples(depth32));
   output_data.values[o+15]=uint(textureSize(depth32).z);
   output_data.values[o+16]=uint(textureSamples(stencil8));
   output_data.values[o+17]=uint(textureSize(stencil8).z);
}
