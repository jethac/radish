#version 450
layout(local_size_x=1) in;
layout(set=0,binding=0) uniform sampler2D source_image;
layout(set=0,binding=1,std430) writeonly buffer Output { uint words[]; };
void main() {
 uint i=gl_GlobalInvocationID.x;
 uvec4 value=uvec4(roundEven(texelFetch(source_image,ivec2(int(i&3u),int(i>>2u)),0)*255.0));
 for(uint c=0;c<4;c++) words[4u*i+c]=value[c];
}
