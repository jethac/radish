%f32_16   = OpConstant %f32 16.0
%f32_31_5 = OpConstant %f32 31.5
%f32_32   = OpConstant %f32 32.0
%f32_63_5 = OpConstant %f32 63.5
%f32_64   = OpConstant %f32 64.0
%f32_127_5 = OpConstant %f32 127.5
%f32_128  = OpConstant %f32 128.0
%f32_256  = OpConstant %f32 256.0
%main     = OpFunction %void None %voidf
%entry    = OpLabel
%idval    = OpLoad %uvec3 %id
%x        = OpCompositeExtract %u32 %idval 0
%inloc    = OpAccessChain %f32ptr %indata %zero %x
%inval    = OpLoad %f32 %inloc
%xabs     = OpExtInst %f32 %ext FAbs %inval
%x8       = OpFMod %f32 %xabs %f32_256
%x7       = OpFMod %f32 %xabs %f32_128
%x6       = OpFMod %f32 %xabs %f32_64
%x5       = OpFMod %f32 %xabs %f32_32
%x4       = OpFMod %f32 %xabs %f32_16
%x3       = OpFMod %f32 %xabs %f32_8
%x2       = OpFMod %f32 %xabs %f32_4
%x1       = OpFMod %f32 %xabs %f32_2
%b7       = OpFOrdGreaterThanEqual %bool %x8 %f32_127_5
%b6       = OpFOrdGreaterThanEqual %bool %x7 %f32_63_5
%b5       = OpFOrdGreaterThanEqual %bool %x6 %f32_31_5
